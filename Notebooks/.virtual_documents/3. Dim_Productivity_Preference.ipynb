import plotly.graph_objects as go

# Build comparison dataframe
comparison = pd.DataFrame({
    "Office": [
        df_productivity["commute_hours_office"].mean(),
        df_productivity["work_hours_office"].mean(),
        df_productivity["personal_family_hours_office"].mean(),
        df_productivity["caring_hours_office"].mean()
    ],
    "Remote": [
        df_productivity["commute_hours_remote"].mean(),
        df_productivity["work_hours_remote"].mean(),
        df_productivity["personal_family_hours_remote"].mean(),
        df_productivity["caring_hours_remote"].mean()
    ]
},
index=[
    "Commute",
    "Work",
    "Personal",
    "Caring"
])

# Create grouped bar chart
fig = go.Figure()
fig.add_trace(go.Bar(x=comparison.index, y=comparison["Office"], name="Office"))
fig.add_trace(go.Bar(x=comparison.index, y=comparison["Remote"], name="Remote"))

fig.update_layout(
    title="Office vs Remote Work: Daily Time Allocation",
    yaxis_title="Average Hours",
    barmode="group"
)

fig.show()









