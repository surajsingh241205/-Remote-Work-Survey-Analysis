


import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

sns.set_style("whitegrid")
plt.rcParams["figure.figsize"] = (8,5)


df_experience = pd.read_excel("../Data/Processed 2020/5. Dim_Remote_Work_Experience.xlsx")


df_experience.head()


df_experience.shape


df_experience.info()


df_experience.describe(include="all").T


df_experience.isnull().sum()


df_experience.duplicated().sum()





import plotly.express as px

# Count values and preserve order (descending frequency)
best_exp_counts = df_experience['best_experience_group_1'].value_counts().reset_index()
best_exp_counts.columns = ['best_experience_group_1', 'count']

# Create horizontal bar chart
fig = px.bar(
    best_exp_counts,
    x='count',
    y='best_experience_group_1',
    orientation='h',
    title='Top Positive Remote Work Experience',
    labels={'count': 'Employee Count', 'best_experience_group_1': 'Experience'}
)

# Keep bars ordered by descending frequency (top to bottom)
fig.update_layout(yaxis={'categoryorder': 'total ascending'})

fig.show()








