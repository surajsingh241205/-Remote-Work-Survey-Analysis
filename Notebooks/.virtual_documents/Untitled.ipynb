# Combine all best experience columns into one series
best_exp = pd.concat([
    df_experience["best_experience_group_1"],
    df_experience["best_experience_group_2"],
    df_experience["best_experience_group_3"],
    df_experience["best_experience_group_4"],
    df_experience["best_experience_group_5"],
    df_experience["best_experience_group_6"]
])

# Count values and preserve order (descending frequency)
overall_best_exp_counts = best_exp.value_counts().reset_index()
overall_best_exp_counts.columns = ['experience', 'count']

# Create horizontal bar chart
fig = px.bar(
    overall_best_exp_counts,
    x='count',
    y='experience',
    orientation='h',
    title='Overall Most Appreciated Remote Work Experiences',
    labels={'count': 'Frequency', 'experience': 'Experience'}
)

# Keep bars ordered by descending frequency (top to bottom)
fig.update_layout(yaxis={'categoryorder': 'total ascending'})

fig.show()








# Combine all worst experience columns into one series
worst_exp = pd.concat([
    df_experience["worst_experience_group_1"],
    df_experience["worst_experience_group_2"],
    df_experience["worst_experience_group_3"],
